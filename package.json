{
  "name": "@kubohiroya/turbowarp-webusb-pasori",
  "version": "0.1.0",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "description": "A TurboWarp capability extension for reading Sony PaSoRi NFC card IDs through WebUSB.",
  "type": "module",
  "homepage": "https://kubohiroya.github.io/turbowarp-webusb-pasori/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-webusb-pasori.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-webusb-pasori/issues"
  },
  "exports": {
    "./webusb-pasori.js": "./dist/webusb-pasori.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "unpkg": "./dist/webusb-pasori.js",
  "jsdelivr": "./dist/webusb-pasori.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "npm run docs && git diff --exit-code -- README.md",
    "docs:pages:check": "node scripts/check-pages.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run docs:check && npm run docs:pages:check && npm run check:dist",
    "check:dist": "npm run build && node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.1.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "nfc",
    "pasori",
    "webusb"
  ]
}
