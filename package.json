{
  "name": "@kubohiroya/turbowarp-webusb-pasori",
  "version": "0.3.0",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "description": "A TurboWarp capability extension for reading Sony PaSoRi NFC card IDs through WebUSB.",
  "type": "module",
  "homepage": "https://kubohiroya.github.io/turbowarp-webusb-pasori/",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-webusb-pasori.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-webusb-pasori/issues"
  },
  "exports": {
    "./webusb-pasori.js": "./dist/webusb-pasori.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "unpkg": "./dist/webusb-pasori.js",
  "jsdelivr": "./dist/webusb-pasori.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "node scripts/generate-readme.ts --check",
    "docs:pages:check": "node scripts/check-pages.ts",
    "repo:check": "node scripts/check-repo.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run docs:pages:check && pnpm run check:dist && pnpm run repo:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "release:check": "pnpm publish --dry-run --access public --no-git-checks",
    "prepack": "pnpm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "0.2.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.4.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "nfc",
    "pasori",
    "webusb"
  ]
}
